UserHandler     --|>    BaseHandler
UserHandler     -->     UserService
UserRepository  -->     User
UserService     -->     UserRepository
MediaHandler    -->     Auth
MediaHandler    -->     GET
MediaHandler    -->     POST
MediaHandler    -->     PUT
MediaHandler    -->     DELETE
UserHandler     -->     Auth
