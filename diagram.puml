MediaService    -->     MediaRepository
Rating          -->     Media
Rating          -->     User
RatingHandler   --|>    BaseHandler
Response        -->     ContentType
Response        -->     HttpStatus
Server          -->     MediaHandler
Server          -->     RatingHandler
Server          -->     UserHandler
